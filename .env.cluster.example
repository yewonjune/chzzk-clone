# 치지직 Kubernetes(cluster 프로필) 비밀 값 예시 — 적용 순서는 k8s/00-namespace.yaml 머리말 참고
#   cp .env.cluster.example .env.cluster      (.env.cluster 는 git 에서 제외됨, 실제 값은 여기에만)
#   kubectl -n chzzk create secret generic chzzk-env --from-env-file=.env.cluster
# 서버 Pod 에는 이 값들이 환경변수로 들어가고, PostgreSQL 도 같은 DB_USERNAME / DB_PASSWORD 로 계정을 만듭니다.
# 접속 주소(DB_URL, REDIS_HOST, UPLOAD_DIR)는 k8s/app.yaml 에 고정되어 있어 여기에 적지 않습니다.
# 주의: --from-env-file 은 따옴표를 벗기지 않으므로 값을 따옴표로 감싸지 마세요.

# ---- PostgreSQL (처음 적용할 때 이 값으로 계정이 만들어짐. 나중에 바꾸려면 PostgreSQL PVC 를 지우고 다시 만들어야 함) ----
DB_USERNAME=chzzk
DB_PASSWORD=change-me

# ---- Redis (선택: 비우면 비밀번호 없이 클러스터 내부에서만 접근) ----
REDIS_PASSWORD=

# ---- HTTPS (선택: 휴대폰 송출용) ----
# true 로 켤 때는 키스토어 Secret 도 함께 만듭니다:
#   kubectl -n chzzk create secret generic chzzk-tls --from-file=keystore.p12=certs/chzzk.p12
SSL_ENABLED=false
SSL_KEYSTORE_PASSWORD=change-me

# ---- 그 밖의 설정 (.env.example 과 같은 이름, 필요한 것만) ----
MAX_VIEWERS_PER_BROADCAST=5
PAYMENT_PROVIDER=auto
# 토스페이먼츠 테스트 키만 (test_ck_ / test_sk_)
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
