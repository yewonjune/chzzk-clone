# 치지직 6단계 OCI 배포 환경변수 예시
#   cp deploy/oci/.env.example deploy/oci/.env  후 값을 채우세요.
#   deploy/oci/.env 는 git 에서 제외됩니다. 실제 비밀번호·키는 이 예시 파일에 적지 마세요.

# ---- 공개 주소 ----
# 구매한 도메인 (DNS A 레코드가 VM 공인 IP 를 가리켜야 인증서 발급됨)
DOMAIN=chzzk-example.com
# Let's Encrypt 인증서 만료 알림 받을 이메일
ACME_EMAIL=you@example.com

# ---- 기록(PostgreSQL) ----
DB_USERNAME=chzzk
# 긴 무작위 값으로 (예: openssl rand -base64 24)
DB_PASSWORD=change-me

# ---- 세션·방 상태(Redis), 비우면 비밀번호 없음 (컨테이너 내부망에서만 열림) ----
REDIS_PASSWORD=

# ---- 방송(WebRTC) ----
MAX_VIEWERS_PER_BROADCAST=5
STUN_URLS=stun:stun.l.google.com:19302
# (선택) VM 의 coturn 을 쓸 때: docker compose --profile turn up -d
# 예: turn:chzzk-example.com:3478
TURN_URL=
TURN_USERNAME=
TURN_PASSWORD=
# "VM공인IP/VM사설IP" 예: 140.238.0.10/10.0.0.23
TURN_EXTERNAL_IP=

# ---- 도네이션: 테스트 키만 (비우면 내장 테스트 결제창) ----
PAYMENT_PROVIDER=auto
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# ---- 데스크톱 앱 ----
DESKTOP_ORIGINS=app://chzzk
DESKTOP_DOWNLOAD_BASE=https://github.com/yewonjune/chzzk-clone/releases/latest/download
DESKTOP_RELEASES_PAGE=https://github.com/yewonjune/chzzk-clone/releases

MAX_UPLOAD_SIZE=1GB
