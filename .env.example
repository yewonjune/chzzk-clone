# 치치직 환경변수 예시 — 모두 선택 사항이며 기본값이 있습니다. 비밀 값은 없습니다.
# Spring Boot 는 .env 파일을 자동으로 읽지 않습니다.
# IntelliJ: Run/Debug Configurations → Environment variables 에 붙여넣기
# 터미널: 환경변수로 설정 후 ./gradlew bootRun

# 서버 포트 (기본 8080)
PORT=8080
# H2 DB 파일(chichijik.mv.db)이 저장될 폴더 (기본 ./data)
DATA_DIR=./data
# 업로드된 영상 파일이 저장될 폴더 (기본 ${DATA_DIR}/uploads)
UPLOAD_DIR=./data/uploads
# 업로드 최대 크기 (기본 1GB, 예: 500MB, 2GB)
MAX_UPLOAD_SIZE=1GB
