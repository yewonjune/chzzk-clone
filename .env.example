# 치치직 환경변수 예시 — 모두 선택 사항이며 기본값이 있습니다.
# 실제 비밀번호는 이 파일에 적지 말고 실행할 때만 설정하세요.
# Spring Boot 는 .env 파일을 자동으로 읽지 않습니다.
#   IntelliJ: Run/Debug Configurations → Environment variables
#   터미널  : 셸 환경변수로 설정 후 ./gradlew bootRun

# ---- 공통 ----
PORT=8080
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE=1GB

# ---- 로그인 세션 ----
SESSION_TIMEOUT=12h

# ---- HTTPS: 휴대폰 카메라·마이크는 HTTPS 에서만 동작 (README "휴대폰으로 송출하기") ----
SSL_ENABLED=false
SSL_KEYSTORE=./certs/chichijik.p12
SSL_KEYSTORE_PASSWORD=change-me

# ---- 방송(WebRTC) ----
MAX_VIEWERS_PER_BROADCAST=5
STUN_URLS=stun:stun.l.google.com:19302
# 막힌 네트워크에서 중계가 필요할 때만 (비우면 TURN 없이 동작)
TURN_URL=
TURN_USERNAME=
TURN_PASSWORD=
