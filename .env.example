# 치치직 환경변수 예시 — 모두 선택 사항이며 기본값이 있습니다.
# 실제 비밀번호는 이 파일에 적지 말고 실행할 때만 설정하세요.
# Spring Boot 는 .env 파일을 자동으로 읽지 않습니다.
#   IntelliJ: Run/Debug Configurations → Environment variables
#   터미널  : 셸 환경변수로 설정 후 ./gradlew bootRun

# ---- 공통 ----
PORT=8080
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE=1GB

# ---- 로그인 세션 ----
SESSION_TIMEOUT=12h

# ---- HTTPS: 휴대폰 카메라·마이크는 HTTPS 에서만 동작 (README "휴대폰으로 송출하기") ----
SSL_ENABLED=false
SSL_KEYSTORE=./certs/chichijik.p12
SSL_KEYSTORE_PASSWORD=change-me

# ---- 방송(WebRTC) ----
MAX_VIEWERS_PER_BROADCAST=5
STUN_URLS=stun:stun.l.google.com:19302
# 막힌 네트워크에서 중계가 필요할 때만 (비우면 TURN 없이 동작)
TURN_URL=
TURN_USERNAME=
TURN_PASSWORD=

# ---- 도네이션 결제 (테스트·샌드박스 전용, README "도네이션 결제 설정") ----
# auto: 아래 두 키가 있으면 토스페이먼츠 테스트 모드, 없으면 내장 테스트 결제창 / toss / fake
PAYMENT_PROVIDER=auto
# 토스페이먼츠 개발자센터 > API 키 > API 개별 연동 키 (테스트 키만 허용: test_ck_ / test_sk_)
# 시크릿 키는 이 파일에 적지 말고 실행할 때만 환경변수로 넣으세요.
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# ---- 5단계: 방송 재연결·종료 (기본값으로 충분) ----
# 송출 연결이 끊긴 뒤 방송을 종료하기 전까지 기다리는 시간 (재연결 유예)
RECONNECT_GRACE=20s
# 송출 연결 없는 방송·만료된 시청자 자리 정리 주기 (밀리초)
SWEEP_INTERVAL_MS=10000
# 종료 신호를 받은 뒤 진행 중인 요청(업로드 등)을 마무리하는 최대 시간
SHUTDOWN_PHASE_TIMEOUT=90s

# ---- 5단계: 여러 인스턴스 (cluster 프로필에서만 사용, README "여러 인스턴스로 실행하기") ----
# Kubernetes 에서는 k8s/app.yaml 이 아래 접속 주소를 설정하고, 비밀 값은 .env.cluster(.env.cluster.example 참고)로 Secret 을 만듭니다.
# 직접 여러 대를 띄울 때만 주석을 풀어 설정하세요. DB_URL·DB_USERNAME·DB_PASSWORD·REDIS_HOST·UPLOAD_DIR 는 cluster 프로필에서 필수입니다.
# SPRING_PROFILES_ACTIVE=cluster
# DB_URL=jdbc:postgresql://localhost:5432/chichijik
# DB_USERNAME=chichijik
# DB_PASSWORD=change-me
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_TIMEOUT=2s
# 모든 인스턴스가 같이 쓰는 업로드 폴더 (공유 볼륨)
# UPLOAD_DIR=/data/uploads
# 인스턴스 하트비트: 이 주기로 갱신하고, TTL 동안 끊기면 다른 인스턴스가 그 연결 기록을 정리
# HEARTBEAT_INTERVAL=5s
# HEARTBEAT_TTL=15s
